{
  "name": "firebase-cr-permissions-tests",
  "version": "1.0.0",
  "description": "Firebase security rules tests for CR permissions",
  "type": "module",
  "scripts": {
    "build": "node inject-env.js",
    "dev": "node inject-env.js && npx serve -l 3000 .",
    "start": "node inject-env.js && npx serve -l 3000 .",
    "update-semesters": "node scripts/update-semesters.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch"
  },
  "dependencies": {
    "@vercel/blob": "^0.27.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "fast-check": "^3.15.0",
    "jest": "^29.7.0"
  }
}
